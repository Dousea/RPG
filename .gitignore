# Python bytecode
__pycache__
*.py[cod]

# Virtualenv (see the README for how it is built)
.venv

# Editor state and the vendored type stubs it generates
.vscode
typings

# Test tooling. .pytest_cache ships its own .gitignore, but say it here too so
# the repo does not depend on a generated file to stay clean.
.pytest_cache

# Claude Code. Worktrees under here are throwaway clones of this whole repo and
# must never be committed; settings.local.json is per-developer. A shared
# .claude/settings.json is deliberately left trackable.
.claude/worktrees/
.claude/settings.local.json

# Local secrets, should any ever be needed. config.yml is tracked and is not the
# place for them.
.env

# The live save, rewritten after every turn. Named exactly rather than with
# gamedata/*.json: the legacy per-file saves next to it are tracked on purpose
# (see the README), and a glob would quietly ignore files git already follows.
# If you rename it via persistence.save_file_name in config.yml, rename it here.
gamedata/engine_state.json
